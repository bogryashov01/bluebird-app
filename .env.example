# Local Bluebird demo API. Copy to `.env` in the workspace root.
# `.env` is gitignored — never commit real credentials.

# Required. Local PostgreSQL connection string.
# Homebrew/Postgres.app example (peer/trust auth, no password):
DATABASE_URL=postgres://localhost:5432/bluebird

# API listen port. Defaults to 8080 if unset. Replit/production may override.
PORT=8080

# API bind address. 0.0.0.0 is reachable on the local LAN and loopback.
# It is not a public internet tunnel. Use 127.0.0.1 to keep the API loopback-only.
HOST=0.0.0.0

# development keeps demo SMS codes, demo billing, queue simulation, and
# mock Concierge fallback. Do not set production locally unless you intend
# to disable those demo paths.
NODE_ENV=development

# JWT signing secret. In development the server falls back to a built-in
# demo secret if this is unset. Set a local value anyway so tokens stay
# stable across restarts you control.
JWT_SECRET=bluebird-local-dev-only

# Optional. Development already enables demo membership/pass checkout.
# Set this only if you need that checkout while NODE_ENV=production.
# DEMO_MODE=true

# Optional. Local demo does not send SMS. Leave unset to use in-band demo
# codes. Production requires Twilio or SMS_WEBHOOK_URL.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SMS_WEBHOOK_URL=

# Optional. Local demo uses mock Concierge replies when no AI key is set.
# OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# CONCIERGE_MODEL=

# Optional logging.
# LOG_LEVEL=info

# Optional. Family invitation emails use Resend in hosted environments.
# Local development skips sending and still returns the acceptance token.
# RESEND_API_KEY=
# EMAIL_FROM=
# PUBLIC_APP_URL=http://localhost:8081

# Optional. Replit object storage. Unset locally — profile photos then persist
# under .local/object-storage (gitignored).
# PRIVATE_OBJECT_DIR=
# PUBLIC_OBJECT_SEARCH_PATHS=
# LOCAL_OBJECT_DIR=

# Optional. Expo project UUID from `npx eas-cli init` in artifacts/bluebird.
# Do not invent this value. After eas init, app.json extra.eas.projectId is
# preferred; this env is only a local override.
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Expo / mobile API origin. No trailing slash and no /api suffix.
# Metro inlines EXPO_PUBLIC_* at bundle time.
#
# localhost works for Expo web and the iOS Simulator:
#   EXPO_PUBLIC_API_URL=http://localhost:8080
#   pnpm --filter @workspace/bluebird run dev:localhost
#   pnpm --filter @workspace/bluebird run dev:ios
#
# Physical iPhone / Expo Go cannot reach the Mac via localhost. Either:
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:8080
# or leave this as localhost and run:
#   pnpm --filter @workspace/bluebird run dev
# which detects the Mac LAN IP and rewrites a loopback API URL for that session.
# Do not commit a machine-specific LAN IP.
#
# iOS Simulator (SDK 54 Expo Go, loopback API):
#   pnpm --filter @workspace/bluebird run dev:ios
#   xcrun simctl boot "iPhone 16 Pro"
#   xcrun simctl launch booted host.exp.Exponent
#   xcrun simctl openurl booted exp://127.0.0.1:8081
# `expo start --ios` needs Simulator.app; some Xcode installs ship DeviceHub instead.
EXPO_PUBLIC_API_URL=http://localhost:8080
