modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Bluebird Clerk Development Web"

[[workflows.workflow]]
name = "Bluebird Clerk Development Web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/bluebird run dev:stage1-web"
waitForPort = 5000

[agent]
stack = "PNPM_WORKSPACE"
expertMode = false

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
EXPO_PUBLIC_ENABLE_CLERK_AUTH = "true"
EXPO_PUBLIC_BLUEBIRD_API_ENVIRONMENT = "production"
EXPO_PUBLIC_BLUEBIRD_DEVELOPMENT_API_BASE_URL = "https://8acaa348-10ff-41b3-9d85-c6b4986aa35a-00-2o2pl95c9l6gv.worf.replit.dev/api"
EXPO_PUBLIC_BLUEBIRD_PRODUCTION_API_BASE_URL = "https://bluebirdjets.com/api"

[userenv.production]
EXPO_PUBLIC_BLUEBIRD_PRODUCTION_API_BASE_URL = "https://bluebirdjets.com/api"

[userenv.shared]
EXPO_PUBLIC_ENABLE_PRODUCTION_CLERK_AUTH = "true"

[objectStorage]
defaultBucketID = "replit-objstore-f0a40bec-9b4f-4071-8b21-26703d69452c"
