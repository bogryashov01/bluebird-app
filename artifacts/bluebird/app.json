{
  "expo": {
    "name": "Bluebird",
    "slug": "bluebird",
    "owner": "replit-private-cd8d8a20-320c-4224-accf-5c9dc7df2ff1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bluebird",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bluebirdjets.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:bluebird.co"
      ]
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bluebird.co",
              "pathPrefix": "/join/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "splash": {
        "image": "./assets/images/bluebird-logo-white.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A1128"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bluebird-logo-white.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A1128"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bluebird to choose a profile photo from your library.",
          "cameraPermission": "Allow Bluebird to take a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Bluebird to add your confirmed flights to your calendar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7becc11e-ad08-40c7-ab29-317fe74c6ed7"
      }
    }
  }
}
